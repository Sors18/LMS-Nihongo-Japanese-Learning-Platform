DATABASE_URL="mysql://root:@localhost:3306/lms_nihongo"
# XAMPP: tạo DB lms_nihongo trong phpMyAdmin trước khi chạy prisma db push
# Gemini (giải nghĩa từ vựng theo ngữ cảnh) — lấy key tại https://aistudio.google.com/apikey
# Không có key vẫn chạy bình thường bằng fallback Jisho + MyMemory
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# JWT — BẮT BUỘC >=32 ký tự khi NODE_ENV=production (tạo: openssl rand -base64 48)
NEXTAUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Bảo mật:
# - TRUST_PROXY=1 chỉ khi chạy sau proxy tin cậy (Nginx/Cloudflare) để rate-limit đọc đúng IP.
#   Chạy trực tiếp (node/npm) thì để trống — header X-Forwarded-For do client gửi sẽ bị bỏ qua.
TRUST_PROXY=
# - Domain production cho Server Actions (chống CSRF), cách nhau dấu phẩy. VD: lms.example.com
ALLOWED_ORIGINS=
